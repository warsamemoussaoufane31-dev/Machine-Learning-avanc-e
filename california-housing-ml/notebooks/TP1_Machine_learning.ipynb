        "print(\"\\nSimple Random Test Set Income Category Proportions:\")\n",
        "print(simple_random_test_proportions)\n",
        "\n",
        "# Stratified test set income_cat proportions\n",
        "# Use the 'test_index' obtained during stratified split to get the corresponding 'income_cat' values from the original full income categories.\n",
        "stratified_test_proportions = housing_original_income_cat.loc[test_index].value_counts(normalize=True).sort_index()\n",
        "print(\"\\nStratified Test Set Income Category Proportions:\")\n",
        "print(stratified_test_proportions)"
