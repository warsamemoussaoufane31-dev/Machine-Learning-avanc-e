# =============================================================================
# PART 2 – BUILDING A DECISION TREE CLASSIFIER
# =============================================================================

# Step 1 – Splitting the dataset
# Question : Why do we use stratify=y?
# Réponse : Pour garder la même proportion de 0/1 (rejets/approbations) dans chaque set.
def make_data(df, cols=None, verbos=False):
    X = df.drop(columns=["loan_status"])
    if cols: X = X[cols]
    y = df["loan_status"]
    X_temp, X_test, y_temp, y_test = train_test_split(X, y, test_size=0.20, stratify=y, random_state=42)
    X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, test_size=0.25, stratify=y_temp, random_state=42)
    
    cat_cols = X.select_dtypes(include=["object", "category"]).columns.tolist()
    num_cols = X.select_dtypes(include=[np.number]).columns.tolist()
    preprocess = ColumnTransformer([
        ("cat", OneHotEncoder(handle_unknown="ignore", sparse_output=False), cat_cols),
        ("num", "passthrough", num_cols)
    ])
    return X_train, X_val, X_test, y_train, y_val, y_test, cat_cols, num_cols, preprocess

# Step 2 & 3 – Training and Evaluation
# Question : What is the difference between gini and entropy?
# Réponse : Gini est plus rapide (probabilité d'erreur). Entropy utilise les logs (mesure du désordre).
def model_tree(preprocess, X_train, X_val, y_train, y_val, max_depth=3, criterion="gini", val=True):
    tree_clf = DecisionTreeClassifier(max_depth=max_depth, criterion=criterion, random_state=42)
    model = Pipeline([("prep", preprocess), ("tree", tree_clf)])
    model.fit(X_train, y_train)
    if val:
        print(classification_report(y_val, model.predict(X_val), digits=3))
    return model

# Question : Which metric matters most: precision or recall?
# Réponse : La Précision (0.852 ici). La banque préfère refuser un bon client (Recall) 
# plutôt que d'approuver un mauvais payeur (Precision), ce qui coûterait plus cher.
X_train, X_val, X_test, y_train, y_val, y_test, cat_cols, num_cols, preprocess = make_data(df, verbos=True)
model = model_tree(preprocess, X_train, X_val, y_train, y_val, max_depth=5, val=True)

# Step 4 – Visualizing the Tree
# Question : Find one rule (e.g., “If defaults = Yes → Reject”). Business intuition?
# Réponse : Un historique de défaut est le signe le plus fiable d'un risque futur.
os.makedirs("DT/images/", exist_ok=True)
ohe = model.named_steps["prep"].named_transformers_["cat"]
feature_names = np.r_[ohe.get_feature_names_out(cat_cols), num_cols]
export_graphviz(model.named_steps["tree"], out_file="DT/images/loan_tree.dot", 
                feature_names=feature_names, class_names=["Rejected", "Approved"], 
                filled=True, rounded=True)
